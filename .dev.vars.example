# Copy to .dev.vars for local development. Never commit .dev.vars.
# In production set these with: npx wrangler secret put NAME
DEV_MODE=true
APP_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Accounts, consent, report, Plus and payments. Off = only the visitor counter.
ACCOUNTS_ENABLED=true
# Show the paid plans and allow checkout (keep false in production until you sell):
PLANS_ON_SALE=true
# For tests of the daily job over HTTP (the scheduled run doesn't need it):
CRON_SECRET=local-cron-secret-for-tests
RAZORPAY_WEBHOOK_SECRET=test-webhook-secret
# Optional locally (without them, emails print to the console and payments are simulated):
# RESEND_API_KEY=
# EMAIL_FROM=Disha <hello@yourdomain.in>
# ADMIN_EMAIL=you@yourdomain.in
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
